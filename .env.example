# Copy this file to .env and fill in values locally (on this Mac and, separately, on the Spark).
# Never commit .env. Never put real tokens in this example file.
#
# Hugging Face (required to load gated CohereLabs/tiny-aya-global)
# 1. Accept the license: https://huggingface.co/CohereLabs/tiny-aya-global
# 2. Create a read token and paste it in .env only.
HF_TOKEN=
# Optional Hugging Face cache root on the Spark (large disk). Example: /home/YOU/.cache/huggingface
HF_HOME=

# DGX Spark over Tailscale MagicDNS
# Replace XXXX with your tailnet suffix, e.g. spark.tail1234.ts.net (not a secret).
SPARK_HOST=spark.tailXXXX.ts.net
SPARK_USER=
SPARK_SSH_PORT=22
# Absolute project path on the Spark, e.g. /home/YOU/lexsi-unlearning
SPARK_PROJECT_DIR=

# Two-tier helper judge (grader / paraphraser / translator).
# The core unlearning model stays CohereLabs/tiny-aya-global (or an optional Aya Expanse stretch).
# Primary (default): Ollama on the Spark, OpenAI-compatible API.
# The pipeline docker run uses --network host, so 127.0.0.1 inside the container is the Spark.
JUDGE_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
JUDGE_MODEL=qwen3.5:35b
# Optional. Default "none" turns Qwen3.x thinking off on Ollama's OpenAI-compatible endpoint; "default" omits the field.
# JUDGE_REASONING_EFFORT=none
# Secondary / frontier judge (optional): OpenRouter, same rubric, seeded sample.
# Only used when OPENROUTER_API_KEY and SECONDARY_JUDGE_MODEL are both set.
# Leave the model blank until you pick a slug from https://openrouter.ai/models
# (this file does not invent one).
OPENROUTER_API_KEY=
SECONDARY_JUDGE_MODEL=
SECONDARY_JUDGE_FRACTION=0.15

# Optional experiment logging. Leave blank to disable.
WANDB_API_KEY=

# Which config profile to use when --config is omitted.
#   spark  -> configs/spark.yaml
#   colab  -> configs/default.yaml
RUN_PROFILE=spark

# Run output directory (artifacts, metrics JSON). Relative to the repo root unless absolute.
OUTPUT_DIR=artifacts

# Optional: NGC API key for `docker login nvcr.io` (username is literally $oauthtoken).
# Official docs: https://docs.nvidia.com/dgx/dgx-spark/ngc.html
# NGC_API_KEY=

# OpenRouter spend guard (src/lexsi_unlearn/spend.py): Lexsi's cap in USD, summed over logs/openrouter_spend.jsonl.
# Calls are skipped (items become missing, never zero) once the ledger sum reaches the cap. Report: scripts/spend_report.py
OPENROUTER_BUDGET_USD=15
