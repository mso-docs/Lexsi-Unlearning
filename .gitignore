data/translations.json

# Generated publication staging (full HF dataset tree, Pages SQLite, etc.)
release/

# The GitHub Pages site lives in docs/ (landing page, assets, downloads, and
# the Evalboard explorer under docs/evalboard/). Those files are tracked.
# scripts/build_pages.sh writes the explorer into docs/evalboard/.
